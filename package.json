{
  "name": "luxe-haven-pms",
  "version": "2.0.0",
  "description": "Luxe Haven - Cloud-Based Hotel Property Management System (PMS)",
  "scripts": {
    "start": "node backend/app.js",
    "dev": "node backend/app.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "node backend/app.js",
    "build": "npm run build --prefix frontend",
    "build:all": "npm install --prefix backend && npm install --prefix frontend && npm run build --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "test": "npm test --prefix backend"
  },
  "keywords": [
    "hotel-pms",
    "property-management-system",
    "react",
    "nodejs",
    "express",
    "fullcalendar",
    "recharts",
    "pdfkit",
    "socketio",
    "rbac"
  ],
